    {
        "id": "bc54f839462af562",
        "type": "function",
        "z": "ca3ec4e87fbb1f03",
        "name": "temp_humidity_dust",
        "func": "\n// var dataTH = msg.payload[\"b6710545512/temphumidity\"];\n// var dataDust = msg.payload[\"b6710545512/dust\"];\n\n// var temp = dataTH.temp;\n// var hum = dataTH.humidity;\n// var dust = dataDust.dust;\n\n// msg.topic = `\n// INSERT INTO air_data (temp, humidity, dust) \n// VALUES (${temp}, ${hum}, ${dust})\n// `;\n\n// return msg;\n\n\nvar dataTH = msg.payload[\"b6710545512/temphumidity\"];\nvar dataDust = msg.payload[\"b6710545512/dust\"];\n\nif (dataTH && dataDust && dataTH.temp > 0 && dataDust.dust > 0) {\n    var t = dataTH.temp;\n    var h = dataTH.humidity;\n    var d = dataDust.dust;\n\n    msg.topic = `INSERT INTO air_data (temp, humidity, dust) VALUES (${t}, ${h}, ${d})`;\n    return msg;\n}\n\nnode.warn(\"Data incomplete or zero - Waiting for next cycle\");\nreturn null;",
