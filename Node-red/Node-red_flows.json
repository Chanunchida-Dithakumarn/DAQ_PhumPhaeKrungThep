    {
        "id": "8f093ddacba8d5d3",
        "type": "function",
        "z": "ca3ec4e87fbb1f03",
        "name": "api",
        "func": "let data = msg.payload;\nlet totalTemp = 0;\nlet totalHum = 0;\nlet totalCloud = 0;\nlet totalPrecip = 0;\nlet totalUV = 0;\nlet count = data.length;\n\nif (count > 0) {\n    data.forEach(function (row) {\n        totalTemp += parseFloat(row.temp) || 0;\n        totalHum += parseFloat(row.humidity) || 0;\n        totalCloud += parseFloat(row.cloudcover) || 0;\n        totalPrecip += parseFloat(row.precip) || 0;\n        totalUV += parseFloat(row.uvindex) || 0;\n    });\n\n    msg.payload = {\n        temp: (totalTemp / count).toFixed(1),\n        humidity: (totalHum / count).toFixed(1),\n        cloud: (totalCloud / count).toFixed(1),\n        precip: (totalPrecip / count).toFixed(2),\n        uv: (totalUV / count).toFixed(1)\n    };\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
