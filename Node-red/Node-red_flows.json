    {
        "id": "9e03b817479b5019",
        "type": "function",
        "z": "ca3ec4e87fbb1f03",
        "name": "sensor",
        "func": "let data = msg.payload;\nlet totalDust = 0;\nlet totalTemp = 0;\nlet totalHum = 0;\nlet count = data.length;\n\ndata.forEach(function (row) {\n    totalDust += row.dust;\n    totalTemp += row.temp;\n    totalHum += row.humidity;\n});\n\nmsg.payload = {\n    dust: (totalDust / count).toFixed(1),\n    temp: (totalTemp / count).toFixed(1),\n    humidity: (totalHum / count).toFixed(1)\n};\nreturn msg;",
        "outputs": 1,
