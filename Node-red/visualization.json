        "z": "ff30491d0bad28d1",
        "name": "Temp",
        "func": "let chartData = [];\n\nmsg.payload.forEach(function (row) {\n    chartData.push({\n        \"x\": new Date(row.ts).getTime(),\n        \"y\": row.temp\n    });\n});\n\nmsg.payload = [{\n    \"series\": [\"Air Temperature\"],\n    \"data\": [chartData],\n    \"labels\": [\"Temperature\"]\n}];\n\nreturn msg;",
